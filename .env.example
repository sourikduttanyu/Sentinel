GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./keys/sentinel.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=

ANTHROPIC_API_KEY=

# LLM_BACKEND: "anthropic" (default) | "gemini" | "openai"
LLM_BACKEND=anthropic

# LLM_MODEL: override the model for the chosen backend.
# Leave blank to use the backend default:
#   anthropic → claude-haiku-4-5-20251001
#   gemini    → gemini-2.0-flash
#   openai    → gpt-4o-mini
LLM_MODEL=

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sentinel
